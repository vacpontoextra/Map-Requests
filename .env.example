# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust. Never commit the real `.env`.
# ---------------------------------------------------------------------------

# SQLite file (path is relative to the /prisma folder). In Docker this is
# overridden to file:/data/requests.db. For PostgreSQL see README.md.
DATABASE_URL="file:./dev.db"

# Public URL of the site (no trailing slash). Used in the User-Agent sent to
# Trackmania.exchange and for the Secure-cookie decision.
BASE_URL="http://localhost:3000"

# Password for the streamer/admin login. Admin features are DISABLED if empty.
# Use a long random string, e.g.:  openssl rand -base64 24
ADMIN_PASSWORD="change-me-to-something-long-and-random"

# Secret used to sign the admin session cookie. Falls back to ADMIN_PASSWORD
# if empty, but a separate value is better:  openssl rand -hex 32
SESSION_SECRET=""

# Optional shared secret for the public request endpoint. If set, callers must
# add &key=THIS_VALUE to the URL. Stops random people from spoofing usernames.
REQUEST_API_KEY=""

# --- Spam protection (all optional) ----------------------------------------
# Min seconds between requests from the same Twitch user.
USER_COOLDOWN_SECONDS=15
# Max unplayed maps a single user may have in the queue (0 = unlimited).
MAX_UNPLAYED_PER_USER=3
# Max requests per minute from one IP. StreamElements calls come from a few
# shared IPs, so keep this generous; the per-user cooldown does the real work.
IP_LIMIT_PER_MINUTE=120

# StreamElements prints the response body in chat. Some setups hide non-200
# bodies, so by default plain-text responses always use HTTP 200 (errors are
# still clearly worded). Set to "false" to use real 4xx/5xx codes in text mode.
TEXT_ALWAYS_200=true

# Thumbnail URL template; {id} is replaced with the TMX map ID.
TMX_THUMBNAIL_TEMPLATE="https://trackmania.exchange/mapthumb/{id}"
