// Prisma schema – PostgreSQL (works with Neon, Supabase, Railway, local Postgres…).
//
// DATABASE_URL = connection string the app uses at runtime (a *pooled* one on serverless hosts)
// DIRECT_URL   = direct (non-pooled) connection used by `prisma migrate deploy`
// On a plain Postgres server both can be the same value.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model MapRequest {
  id           Int       @id @default(autoincrement())

  // --- Trackmania.exchange metadata (validated + fetched at request time) ---
  mapId        Int                       // TMX map ID
  mapUid       String                    // Nadeo map UID
  name         String
  author       String
  tags         String    @default("[]")  // JSON array of tag names, stored as text
  thumbnailUrl String?
  length       String?                   // e.g. "45 secs"
  difficulty   String?                   // e.g. "Intermediate"
  awards       Int       @default(0)
  tmxUrl       String

  // --- Who/when ---
  username     String                    // Twitch name as displayed
  usernameKey  String                    // lowercase copy for case-insensitive lookups
  requestedAt  DateTime  @default(now()) // server time (UTC); date + time both derive from this

  // --- Status ---
  played       Boolean   @default(false)
  playedAt     DateTime?

  @@index([played, requestedAt])
  @@index([mapId])
  @@index([usernameKey])
}
